{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nnegherbon/IOT-ESP32-Sensor-de-luz/contrato/v1/status.schema.json",
  "title": "status",
  "description": "luzambiente/v1/{backend|sensor/<id>|atuador/<id>}/status — retido, QoS 1, também usado como LWT (online=false).",
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "Versão do contrato. Mudança incompatível = novo prefixo luzambiente/v2."
    },
    "device": {
      "type": "string",
      "pattern": "^([a-z][a-z0-9-]{2,31})$"
    },
    "online": {
      "type": "boolean"
    },
    "fw": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "ip": {
      "type": "string"
    },
    "rssi": {
      "type": "integer",
      "minimum": -120,
      "maximum": 0
    }
  },
  "required": [
    "v",
    "device",
    "online"
  ],
  "additionalProperties": true
}