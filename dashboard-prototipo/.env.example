# Copie para .env e ajuste. NUNCA versione o .env.

# --- PostgreSQL ---
POSTGRES_DB=luz
POSTGRES_USER=luz
POSTGRES_PASSWORD=troque-esta-senha
# Fora do Docker, informe a URL completa:
# DATABASE_URL=postgresql://luz:troque-esta-senha@localhost:5432/luz

# --- MQTT ---
# "mosquitto" = broker local do docker-compose (nome do serviço na rede Docker).
# Os ESP32 usam o IP deste computador na rede Wi-Fi, porta 1883.
MQTT_ENABLED=true
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_TLS=false
# O broker público não exige autenticação. Para um cluster HiveMQ Cloud privado,
# preencha usuário/senha e use MQTT_PORT=8883 e MQTT_TLS=true.
MQTT_USERNAME=backend
MQTT_PASSWORD=troque
# Assina tudo sob a base do projeto; tópicos não reconhecidos ficam como "nao_tratado".
MQTT_SUBSCRIBE=iot/luzambiente/#
# Prefixo do client ID do backend (um sufixo aleatório é sempre adicionado).
MQTT_CLIENT_ID_PREFIX=luz-dashboard

# --- Modo demonstração ---
# true = gera dados sintéticos localmente (não conecta ao broker). Os dados
# ficam marcados com is_demo=true e não se misturam com os reais.
DEMO_MODE=false
DEMO_INTERVAL_S=1.0

# --- API ---
# Origens permitidas quando o frontend roda fora do nginx (ex.: npm run dev).
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
STORE_RAW_PAYLOADS=true

# --- Docker ---
HTTP_PORT=8081

# ======================= N3 =======================
# Senhas do broker, uma por dispositivo + backend (o broker recusa conexões anônimas; ACL em mosquitto/acl).
# O backend usa MQTT_USERNAME=backend e MQTT_PASSWORD igual a MQTT_PASS_BACKEND.
MQTT_PASS_BACKEND=troque
MQTT_PASS_SENSOR01=troque
MQTT_PASS_ATUADOR01=troque

# Login da interface (R9) e perfis (R16): nome:senha:perfil separados por vírgula.
# admin comanda e altera a regra; operador só visualiza.
AUTH_USERS=admin:troque:admin,operador:troque:operador
# Segredo que assina os tokens (gere com: openssl rand -hex 32)
AUTH_SECRET=

# Notificação externa (R15): preencha um canal.
# ntfy: instale o app ntfy no celular e assine o mesmo tópico (use um nome difícil de adivinhar).
NTFY_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_MIN_SEVERITY=critico

# Senha do OTA dos firmwares (a mesma do secrets.h), usada pelo arduino-cli na atualização pela rede
OTA_PASS=
