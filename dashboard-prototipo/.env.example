# Copie para .env e ajuste. NUNCA versione o .env.

# --- PostgreSQL ---
POSTGRES_DB=luz
POSTGRES_USER=luz
POSTGRES_PASSWORD=troque-esta-senha
# Fora do Docker, informe a URL completa:
# DATABASE_URL=postgresql://luz:troque-esta-senha@localhost:5432/luz

# --- MQTT (padrões = os mesmos do firmware) ---
MQTT_ENABLED=true
MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883
MQTT_TLS=false
# O broker público não exige autenticação. Para um cluster HiveMQ Cloud privado,
# preencha usuário/senha e use MQTT_PORT=8883 e MQTT_TLS=true.
MQTT_USERNAME=
MQTT_PASSWORD=
# Assina tudo sob a base do projeto; tópicos não reconhecidos ficam como "nao_tratado".
MQTT_SUBSCRIBE=iot/luzambiente/#
# Prefixo do client ID do backend (um sufixo aleatório é sempre adicionado).
MQTT_CLIENT_ID_PREFIX=luz-dashboard

# --- Modo demonstração ---
# true = gera dados sintéticos localmente (não conecta ao broker). Os dados
# ficam marcados com is_demo=true e não se misturam com os reais.
DEMO_MODE=false
DEMO_INTERVAL_S=1.0

# --- API ---
# Origens permitidas quando o frontend roda fora do nginx (ex.: npm run dev).
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
STORE_RAW_PAYLOADS=true

# --- Docker ---
HTTP_PORT=8080
