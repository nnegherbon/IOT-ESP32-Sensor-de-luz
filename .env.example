POSTGRES_DB=iot
POSTGRES_USER=iot
POSTGRES_PASSWORD=iot_aula

# Dentro do Docker o backend acha o broker pelo nome do servico.
# Nos ESP32 este valor precisa ser o IP do computador (nunca localhost).
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_BASE_TOPIC=iot/luzambiente

# --- LUZ (LDR) — sensor ativo hoje -----------------------------------------
# Limiar em % de luminosidade (0-100, maior = mais claro). Abaixo dele o
# ambiente e considerado escuro. Calibrar em laboratorio: docs/CALIBRACAO.md.
AUTOMATION_LUZ_LIMIAR=40
AUTOMATION_LUZ_HISTERESE=8

# --- SOM (microfone) — desativado, hardware ainda nao montado --------------
# Enquanto SOM_HABILITADO=false, o backend usa SOM_VALOR_PADRAO em vez de
# esperar uma leitura real. Ver docs/CONFIGURACAO.md.
SOM_HABILITADO=false
SOM_VALOR_PADRAO=0
AUTOMATION_SOM_MEDIO=25
AUTOMATION_SOM_ALTO=55
AUTOMATION_SOM_HISTERESE=6

# --- OCUPACAO (PIR) — desativado, hardware ainda nao montado ---------------
# Enquanto OCUPACAO_HABILITADA=false, o ambiente e sempre considerado
# ocupado e a decisao depende so da luz. Ver docs/CONFIGURACAO.md.
OCUPACAO_HABILITADA=false
AUTOMATION_CARENCIA_S=120

# Brilho maximo 0-255. Segurar baixo protege a fonte USB.
AUTOMATION_BRILHO_MAX=120
